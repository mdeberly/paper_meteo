<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Widgets réglés sur la position GPS : suivre les déplacements quand l'appli est fermée. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="Paper Meteo"
        android:theme="@style/Theme.Pluie">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:label="Paramètres"
            android:screenOrientation="portrait" />

        <!-- Widgets 4 × 2 : prévisions seules (jours, heures) ou météo actuelle avec prévisions. -->
        <receiver
            android:name=".Widgets$Days"
            android:exported="true"
            android:label="@string/widget_days">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_days" />
        </receiver>

        <receiver
            android:name=".Widgets$Hours"
            android:exported="true"
            android:label="@string/widget_hours">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hours" />
        </receiver>

        <receiver
            android:name=".Widgets$NowDays"
            android:exported="true"
            android:label="@string/widget_now_days">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_days" />
        </receiver>

        <receiver
            android:name=".Widgets$NowHours"
            android:exported="true"
            android:label="@string/widget_now_hours">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_hours" />
        </receiver>

        <receiver
            android:name=".Widgets$Big"
            android:exported="true"
            android:label="@string/widget_big">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_big" />
        </receiver>

        <receiver
            android:name=".Widgets$Radar"
            android:exported="true"
            android:label="@string/widget_radar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_radar" />
        </receiver>
    </application>
</manifest>
